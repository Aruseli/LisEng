# Прямой Postgres (тот же, что Hasura). На Vercel обязателен — без него /api/auth/* даёт 500.
DATABASE_URL=
VITE_HASURA_GRAPHQL_URL=
HASURA_GRAPHQL_URL=
HASURA_ADMIN_SECRET=
HASURA_JWT_SECRET=
HASURA_EVENT_SECRET=
# Минимум 32 символа (иначе better-auth предупреждает и сессии нестабильны)
BETTER_AUTH_SECRET=
# Публичный URL приложения без слэша. На Vercel: https://lis-eng.vercel.app (не localhost)
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Запасной override на все chat-роли. Если пусто — смотрим PREMIUM/BUDGET.
OPENROUTER_MODEL=
# Предпочтительный slug 3.5; если в каталоге ключа его нет, код берёт anthropic/claude-sonnet-4.
OPENROUTER_MODEL_PREMIUM=
OPENROUTER_MODEL_BUDGET=deepseek/deepseek-r1-0528
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY=
